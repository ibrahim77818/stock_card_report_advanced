<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="stock_card_report_advanced.StockCardReport">
        <div class="o_action o_stock_card_report">
            <div class="o_sc_toolbar">
                <div class="o_sc_heading">
                    <h2 class="o_sc_h">Stock Card</h2>
                    <div class="o_sc_period" t-if="state.meta.period_label">
                        <t t-out="state.meta.period_label"/>
                        <span class="o_sc_dot" t-out="'·'"/>
                        <t t-out="state.meta.company_name"/>
                    </div>
                </div>
                <div class="o_sc_actions">
                    <button class="btn btn-primary" t-on-click="onEditFilters">
                        <i class="fa fa-sliders me-1"/>Filters
                    </button>
                    <button class="btn btn-secondary" t-on-click="onPrintPdf" t-att-disabled="state.loading or state.error">
                        <i class="fa fa-file-pdf-o me-1"/>PDF
                    </button>
                    <button class="btn btn-secondary" t-on-click="onExportXlsx" t-att-disabled="state.loading or state.error">
                        <i class="fa fa-file-excel-o me-1"/>XLSX
                    </button>
                </div>
            </div>

            <div class="o_sc_filters" t-if="state.meta.locations_label">
                <span class="o_sc_chip"><i class="fa fa-map-marker me-1"/><t t-out="state.meta.locations_label"/></span>
                <span class="o_sc_chip"><i class="fa fa-cubes me-1"/><t t-out="state.meta.products_label"/></span>
                <span class="o_sc_chip"><i class="fa fa-folder-o me-1"/><t t-out="state.meta.categories_label"/></span>
                <span class="o_sc_chip"><i class="fa fa-clock-o me-1"/><t t-out="state.meta.tz"/></span>
                <span class="o_sc_chip"><i class="fa fa-list me-1"/><t t-out="state.meta.mode_label"/></span>
                <span class="o_sc_chip o_sc_chip_value" t-if="state.meta.show_valuation">Stock Value: <b t-out="formatMoney(state.meta.total_closing_value)"/></span>
            </div>

            <div class="o_sc_body">
                <t t-if="state.loading">
                    <div class="o_sc_state"><i class="fa fa-circle-o-notch fa-spin me-2"/>Computing stock card…</div>
                </t>
                <t t-elif="state.error">
                    <div class="alert alert-warning o_sc_state_alert" role="alert">
                        <t t-out="state.error"/>
                    </div>
                </t>
                <t t-else="">
                    <div class="o_sc_subbar">
                        <input type="search" class="form-control o_sc_search" placeholder="Filter products or locations…"
                               t-att-value="state.search" t-on-input="onSearchInput"/>
                        <span class="o_sc_count">Stock Cards: <b><t t-out="filteredGroups.length"/> / <t t-out="state.groups.length"/></b></span>
                        <button class="btn btn-link" t-on-click="expandAll" t-if="state.groups.length">
                            <i class="fa fa-expand me-1"/>Expand all
                        </button>
                        <button class="btn btn-link" t-on-click="collapseAll" t-if="isAnyExpanded">
                            <i class="fa fa-compress me-1"/>Collapse all
                        </button>
                    </div>

                    <div t-if="!filteredGroups.length" class="o_sc_state">
                        No stock movement matches the selected filters.
                    </div>

                    <div t-else="" class="o_sc_table_wrap">
                        <table class="table table-sm o_sc_table">
                            <thead>
                                <tr t-if="isSummary" class="o_sc_cols_totals">
                                    <th t-if="state.meta.interval === 'day'" class="o_sc_t_date">Date</th>
                                    <th t-else="" class="o_sc_t_date">Period</th>
                                    <th class="o_sc_c_num">In Quantity</th>
                                    <th class="o_sc_c_num">Out Quantity</th>
                                    <th class="o_sc_c_num">Running Balance</th>
                                    <th t-if="state.meta.show_valuation" class="o_sc_c_num">
                                        Balance Value <span class="o_sc_cur" t-out="state.meta.currency_name"/>
                                    </th>
                                </tr>
                                <tr t-else="">
                                    <th class="o_sc_c_date">Date</th>
                                    <th class="o_sc_c_ref">Reference / Origin</th>
                                    <th class="o_sc_c_type">Move Type</th>
                                    <th class="o_sc_c_loc">Source Location</th>
                                    <th class="o_sc_c_loc">Destination Location</th>
                                    <th class="o_sc_c_num">In Quantity</th>
                                    <th class="o_sc_c_num">Out Quantity</th>
                                    <th class="o_sc_c_num">Running Balance</th>
                                    <th t-if="state.meta.show_valuation" class="o_sc_c_num">
                                        Balance Value <span class="o_sc_cur" t-out="state.meta.currency_name"/>
                                    </th>
                                </tr>
                            </thead>
                            <t t-foreach="filteredGroups" t-as="group" t-key="group.key">
                                <tbody t-att-class="{'o_sc_open': state.expanded[group.key]}">
                                    <tr class="o_sc_group_row" t-on-click="() => this.toggleGroup(group)">
                                        <td t-att-colspan="isSummary ? 1 : 5" t-att-class="isSummary ? 'o_sc_group_stacked' : ''">
                                            <i t-att-class="'fa fa-fw o_sc_caret ' + (state.expanded[group.key] ? 'fa-caret-down' : 'fa-caret-right')"/>
                                            <a href="#" class="o_sc_product" t-on-click.prevent.stop="() => this.openProduct(group)"
                                               t-out="group.product_name"/>
                                            <t t-if="group.location_name">
                                                <span class="o_sc_dot" t-out="'·'"/>
                                                <a href="#" class="o_sc_location" t-on-click.prevent.stop="() => this.openLocation(group.location_id)"
                                                   t-out="group.location_name"/>
                                            </t>
                                            <span class="badge o_sc_badge" t-out="group.uom_name"/>
                                            <span class="o_sc_group_meta">
                                                <span class="o_sc_meta_small">Opening: <b t-out="formatQty(group.opening)"/></span>
                                                <span class="o_sc_meta_small">Movements: <b t-out="group.move_count"/></span>
                                                <span t-if="state.meta.show_valuation" class="o_sc_meta_small">Unit Cost: <b t-out="formatMoney(group.unit_cost, true)"/></span>
                                            </span>
                                        </td>
                                        <td class="o_sc_num o_sc_in" t-out="formatQty(group.qty_in)"/>
                                        <td class="o_sc_num o_sc_out" t-out="formatQty(group.qty_out)"/>
                                        <td t-att-class="'o_sc_num o_sc_bal ' + balanceClass(group.closing)" t-out="formatQty(group.closing)"/>
                                        <td t-if="state.meta.show_valuation" t-att-class="'o_sc_num o_sc_value ' + balanceClass(group.closing_value)"
                                            t-out="formatMoney(group.closing_value)"/>
                                    </tr>
                                    <t t-if="state.expanded[group.key]">
                                        <tr t-if="state.loadingKeys[group.key]" class="o_sc_loading_row">
                                            <td t-att-colspan="nCols"><i class="fa fa-circle-o-notch fa-spin me-2"/>Loading moves…</td>
                                        </tr>
                                        <t t-else="">
                                            <tr class="o_sc_opening">
                                                <td t-att-colspan="isSummary ? 3 : 7">Opening Balance</td>
                                                <td t-att-class="'o_sc_num ' + balanceClass(group.opening)" t-out="formatQty(group.opening)"/>
                                                <td t-if="state.meta.show_valuation" class="o_sc_num" t-out="formatMoney(group.opening_value)"/>
                                            </tr>
                                            <t t-foreach="state.lines[group.key] || []" t-as="line" t-key="line.uid">
                                            <tr t-if="isSummary" class="o_sc_line">
                                                <td class="o_sc_nowrap" t-out="line.date_display"/>
                                                <td class="o_sc_num o_sc_in" t-out="formatQty(line.qty_in, true)"/>
                                                <td class="o_sc_num o_sc_out" t-out="formatQty(line.qty_out, true)"/>
                                                <td t-att-class="'o_sc_num o_sc_bal ' + balanceClass(line.running_balance)"
                                                    t-out="formatQty(line.running_balance)"/>
                                                <td t-if="state.meta.show_valuation" t-att-class="'o_sc_num o_sc_value ' + balanceClass(line.balance_value)"
                                                    t-out="formatMoney(line.balance_value)"/>
                                            </tr>
                                            <tr t-else="" class="o_sc_line">
                                                <td class="o_sc_nowrap" t-out="line.date_display"/>
                                                <td>
                                                    <a href="#" t-on-click.prevent="() => this.openLine(line)"
                                                       t-out="line.reference || '—'"/>
                                                    <div t-if="line.origin or line.invoice_refs" class="o_sc_origin">
                                                        <t t-out="line.origin"/>
                                                        <t t-if="line.invoice_refs">
                                                            <span class="o_sc_dot" t-out="'·'"/>
                                                            <a href="#" class="o_sc_inv" t-att-title="line.invoice_label"
                                                               t-on-click.prevent="() => this.openInvoices(line)" t-out="line.invoice_refs"/>
                                                        </t>
                                                    </div>
                                                </td>
                                                <td><span t-att-class="'o_sc_type o_sc_type_' + line.move_type" t-out="line.move_type_label"/></td>
                                                <!-- virtual locations (vendors, customers, adjustments, scrap...) are left blank -->
                                                <td t-out="line.src_virtual ? '' : line.src_name"/>
                                                <td t-out="line.dst_virtual ? '' : line.dst_name"/>
                                                <td class="o_sc_num o_sc_in" t-out="formatQty(line.qty_in, true)"/>
                                                <td class="o_sc_num o_sc_out" t-out="formatQty(line.qty_out, true)"/>
                                                <td t-att-class="'o_sc_num o_sc_bal ' + balanceClass(line.running_balance)"
                                                    t-out="formatQty(line.running_balance)"/>
                                                <td t-if="state.meta.show_valuation" t-att-class="'o_sc_num o_sc_value ' + balanceClass(line.balance_value)"
                                                    t-out="formatMoney(line.balance_value)"/>
                                            </tr>
                                            </t>
                                            <tr class="o_sc_total">
                                                <td t-att-colspan="isSummary ? 1 : 5" class="text-end">Totals / Closing Balance</td>
                                                <td class="o_sc_num" t-out="formatQty(group.qty_in)"/>
                                                <td class="o_sc_num" t-out="formatQty(group.qty_out)"/>
                                                <td t-att-class="'o_sc_num ' + balanceClass(group.closing)" t-out="formatQty(group.closing)"/>
                                                <td t-if="state.meta.show_valuation" class="o_sc_num" t-out="formatMoney(group.closing_value)"/>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                            </t>
                        </table>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
