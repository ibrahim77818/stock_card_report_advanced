<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_stock_card" model="report.paperformat">
        <field name="name">Stock Card (A4 Landscape)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">26</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_stock_card" model="ir.actions.report">
        <field name="name">Stock Card</field>
        <field name="model">stock.card.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_card_report_advanced.report_stock_card</field>
        <field name="report_file">stock_card_report_advanced.report_stock_card</field>
        <field name="print_report_name">'Stock Card - %s - %s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_stock_card"/>
    </record>
</odoo>
